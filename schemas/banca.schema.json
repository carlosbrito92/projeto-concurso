{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perfil estatístico de banca (schema v1)",
  "type": "object",
  "required": ["schemaVersion", "banca", "amostra", "medidas", "origem"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "banca": { "type": "string" },
    "amostra": {
      "type": "object",
      "required": ["provas", "totalQuestoes", "confianca", "aviso"],
      "additionalProperties": false,
      "properties": {
        "provas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slug", "orgao", "ano", "cargo", "questoes", "alternativas", "gabarito"],
            "additionalProperties": false,
            "properties": {
              "slug": { "type": "string" },
              "orgao": { "type": "string" },
              "ano": { "type": "integer" },
              "cargo": { "type": "string" },
              "questoes": { "type": "integer" },
              "alternativas": { "type": "integer" },
              "gabarito": { "type": "string" }
            }
          }
        },
        "totalQuestoes": { "type": "integer" },
        "confianca": { "enum": ["baixa", "media", "alta"] },
        "aviso": { "type": "string" }
      }
    },
    "medidas": { "type": "object" },
    "origem": { "type": "string" }
  }
}
