# Copie para .env.local (desenvolvimento) e configure o mesmo conjunto na Vercel. NUNCA commitar valores.

# --- Ambiente ---
# dev | teste | producao. Em produção a política de questões é sempre a padrão (só questões liberadas juridicamente).
APP_ENV=dev
# Somente em APP_ENV=teste, num deploy privado: libera questões ainda pendentes de direitos para o tester. Proibido em produção.
# POLITICA_QUESTOES=desenvolvimento
# Demonstração local (dados em memória, sem login). O app recusa DEMO=1 fora de desenvolvimento.
# DEMO=1

# --- Administração ---
# IDs do Clerk (user_...) com acesso a /admin (reportes e banco de questões), separados por vírgula. Vazio = ninguém é admin.
# O ID está em Clerk > Users > (usuário) ou em auth().userId. Quem não é admin recebe 404 nessas rotas.
ADMIN_USER_IDS=

# --- Supabase (valores públicos por desenho) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só servidor. Crie uma chave secreta (sb_secret_...) dedicada em Project Settings > API Keys e revogue-a ao fim dos testes.
SUPABASE_SECRET_KEY=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/painel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/painel
